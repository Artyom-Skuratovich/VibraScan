<UserControl x:Class="VibraScan.Presentation.Views.DataImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:VibraScan.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#E2E8F0"
                Padding="20"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.02" Color="Black"/>
            </Border.Effect>

            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource FluentPrimaryButton}"
                            Content="Выбрать XML файлы"
                            Padding="24,0" Height="38"/>

                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Импорт диагностических данных двигателей" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13"/>
                        <TextBlock Text="Поддерживаются файл в формате (*.xml)" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0,0,0">
                    <Button DockPanel.Dock="Right" 
                            Style="{StaticResource FluentPrimaryButton}"
                            Content="Запустить импорт"
                            Padding="24,0" Height="38"
                            FontWeight="SemiBold"/>

                    <Button Style="{StaticResource FluentSecondaryButton}"
                            Content="Отмена"
                            Padding="20,0" Height="38"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#E2E8F0"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Общий прогресс импорта:" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                    <TextBlock Text="Обработан файл: kill_me_pls.xml" Foreground="#64748B" FontSize="13" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="3" FontWeight="Bold" Foreground="#2563EB" FontSize="13"/>
                    <TextBlock Text=" из " Foreground="#94A3B8" FontSize="13"/>
                    <TextBlock Text="28" FontWeight="Bold" Foreground="#334155" FontSize="13"/>
                </StackPanel>

                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                             Value="3" Minimum="0" Maximum="28"
                             Height="8" Foreground="#2563EB" Background="#F1F5F9" BorderThickness="0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Выбранные файлы для обработки" 
                       FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="4,0,0,8"/>

            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0">
                <ListBox x:Name="TestListBox" Background="Transparent" BorderThickness="0" Padding="8" 
                         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemRowContainer" Padding="6,6" CornerRadius="6" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" 
                                          Fill="#3B82F6" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,12,0"/>

                                    <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                               Foreground="#0F172A" FontSize="13" FontWeight="Medium"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <ProgressBar Grid.Column="2"
                                                 Value="30" Minimum="0" Maximum="100"
                                                 Height="8" Margin="0,0,24,0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                 Foreground="#2563EB" Background="#F1F5F9" BorderThickness="0"/>

                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" 
                                               Foreground="#64748B" FontSize="12" 
                                               VerticalAlignment="Center" Margin="0,0,16,0" TextAlignment="Right"/>

                                    <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                              Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                    <Setter TargetName="ItemRowContainer" Property="Background" Value="#FEF2F2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Журнал импорта" 
                       FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="4,0,0,8"/>

            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="12">
                <TextBox Text="{Binding LogConsoleOutput, Mode=OneWay}"
                         Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>