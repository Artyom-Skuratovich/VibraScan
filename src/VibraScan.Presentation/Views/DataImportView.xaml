<UserControl
    x:Class="VibraScan.Presentation.Views.DataImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VibraScan.Presentation.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#F8FAFC"
    mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,16"
            Padding="20"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Opacity="0.02"
                    ShadowDepth="1"
                    Color="Black" />
            </Border.Effect>

            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button
                        Height="38"
                        Padding="24,0"
                        Content="Выбрать XML файлы"
                        Style="{StaticResource FluentPrimaryButton}" />

                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#0F172A"
                            Text="Импорт диагностических данных двигателей" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="#64748B"
                            Text="Поддерживаются файл в формате (*.xml)" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Margin="20,0,0,0"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Height="38"
                        Padding="24,0"
                        Content="Запустить импорт"
                        DockPanel.Dock="Right"
                        FontWeight="SemiBold"
                        Style="{StaticResource FluentPrimaryButton}" />

                    <Button
                        Height="38"
                        Margin="8,0,0,0"
                        Padding="20,0"
                        Content="Отмена"
                        Style="{StaticResource FluentSecondaryButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,0,0,16"
            Padding="16"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,0,8"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#334155"
                        Text="Общий прогресс импорта:" />
                    <TextBlock
                        Margin="8,0,0,0"
                        FontSize="13"
                        Foreground="#64748B"
                        Text="Обработан файл: kill_me_pls.xml" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="#2563EB"
                        Text="3" />
                    <TextBlock
                        FontSize="13"
                        Foreground="#94A3B8"
                        Text=" из " />
                    <TextBlock
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="#334155"
                        Text="28" />
                </StackPanel>

                <ProgressBar
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Height="8"
                    Background="#F1F5F9"
                    BorderThickness="0"
                    Foreground="#2563EB"
                    Maximum="28"
                    Minimum="0"
                    Value="3" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="4,0,0,8"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#475569"
                Text="Выбранные файлы для обработки" />

            <Border
                Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8">
                <ListBox
                    x:Name="TestListBox"
                    Padding="8"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="ItemRowContainer"
                                Padding="6,6"
                                Background="Transparent"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Path
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        Margin="4,0,12,0"
                                        VerticalAlignment="Center"
                                        Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                                        Fill="#3B82F6"
                                        Stretch="Uniform" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="#0F172A"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis" />

                                    <ProgressBar
                                        Grid.Column="2"
                                        Height="8"
                                        Margin="16,0,16,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Background="#F1F5F9"
                                        BorderThickness="0"
                                        Foreground="#2563EB"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="30" />

                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#64748B"
                                        Text="{Binding StatusText}"
                                        TextAlignment="Right" />

                                    <Button
                                        Grid.Column="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand">
                                        <Path
                                            Width="12"
                                            Height="12"
                                            Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                            Fill="#94A3B8"
                                            Stretch="Uniform" />
                                    </Button>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                    <Setter TargetName="ItemRowContainer" Property="Background" Value="#FEF2F2" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="4,0,0,8"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#475569"
                Text="Журнал импорта" />

            <Border
                Grid.Row="1"
                Padding="12"
                Background="#0F172A"
                CornerRadius="8">
                <TextBox
                    AcceptsReturn="True"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#E2E8F0"
                    IsReadOnly="True"
                    Text="{Binding LogConsoleOutput, Mode=OneWay}"
                    VerticalScrollBarVisibility="Auto" />
            </Border>
        </Grid>
    </Grid>
</UserControl>