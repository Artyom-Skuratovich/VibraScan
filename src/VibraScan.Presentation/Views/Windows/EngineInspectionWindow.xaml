<Window
    x:Class="VibraScan.Presentation.Views.Windows.EngineInspectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibraScan.Presentation.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels"
    Title="{Binding Title}"
    Width="500"
    Height="460"
    d:DataContext="{d:DesignInstance Type=vm:EngineInspectionViewModel,
                                     IsDesignTimeCreatable=False}"
    Background="#F1F5F9"
    FontWeight="Medium"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="16"
            Padding="20"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="9">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.03"
                    ShadowDepth="1"
                    Color="Black" />
            </Border.Effect>

            <Border.Resources>
                <Style x:Key="FieldHeaderStyle" TargetType="TextBlock">
                    <Setter Property="Margin" Value="2,0,0,6" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="#64748B" />
                </Style>
            </Border.Resources>

            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldHeaderStyle}" Text="Состояние" />
                    <ComboBox
                        ItemsSource="{Binding AvailableConditions}"
                        SelectedItem="{Binding SelectedCondition}"
                        Style="{StaticResource FluentComboBox}"
                        Tag="-- Выберите состояние --" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldHeaderStyle}" Text="Дата последней проверки" />
                    <DatePicker
                        SelectedDate="{Binding LastInspectionDate}"
                        Style="{StaticResource FluentDatePicker}"
                        Tag="-- Выбеите дату последней проверки --" />
                </StackPanel>

                <CheckBox
                    Margin="2,4,0,16"
                    Content="Разрешить редактирование даты след. проверки"
                    FontSize="13"
                    Foreground="#475569"
                    IsChecked="{Binding AllowedEditNextDate}" />

                <StackPanel>
                    <TextBlock Style="{StaticResource FieldHeaderStyle}" Text="Дата следующей проверки" />
                    <DatePicker
                        IsEnabled="{Binding AllowedEditNextDate, Mode=OneWay}"
                        SelectedDate="{Binding NextInspectionDate}"
                        Tag="-- Введите дату след. проверки --">

                        <DatePicker.Style>
                            <Style BasedOn="{StaticResource FluentDatePicker}" TargetType="DatePicker">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ValidationError, Converter={StaticResource StrHasValConverter}}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DatePicker.Style>

                    </DatePicker>

                    <DockPanel Margin="2,6,0,0" LastChildFill="True">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ValidationError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <Ellipse
                            Width="5"
                            Height="5"
                            Margin="0,5,6,0"
                            VerticalAlignment="Top"
                            DockPanel.Dock="Left"
                            Fill="#EF4444" />

                        <TextBlock
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="#EF4444"
                            Text="{Binding ValidationError}"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>

            </StackPanel>

        </Border>

        <Border
            Grid.Row="1"
            Padding="16,0,16,16"
            Background="Transparent">
            <DockPanel LastChildFill="False">
                <Button
                    Command="{Binding CancelOperationCommand}"
                    Content="Отмена"
                    DockPanel.Dock="Left"
                    Style="{StaticResource FluentSecondaryButton}" />

                <Button
                    Command="{Binding ApplyCommand}"
                    Content="Применить"
                    DockPanel.Dock="Right"
                    IsDefault="True"
                    Style="{StaticResource FluentPrimaryButton}" />
            </DockPanel>
        </Border>

    </Grid>

</Window>