<Window x:Class="VibraScan.Presentation.Views.Windows.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VibraScan.Presentation.Views.Windows"
        xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ErrorViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}"
        Height="Auto" 
        Width="450"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        MinWidth="400"
        MaxWidth="600">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/DataTemplates/NotificationTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Padding="24">
            <DockPanel>
                <Button DockPanel.Dock="Bottom"
                        Content="Копировать детали"
                        Command="{Binding CopyToClipboardCommand}"
                        Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Padding="15,6" Margin="0,20,10,0"
                        Background="Transparent" BorderBrush="#CCCCCC"
                        HorizontalAlignment="Right"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="&#xE783;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="24" Foreground="#C5221F"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Произошла ошибка"
                                       FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Message, FallbackValue='Кастомная ошибка'}"
                                   TextWrapping="Wrap"
                                   FontSize="14" Foreground="#333333"
                                   Margin="0,0,0,16"/>

                        <Expander Header="Подробности" Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Foreground="#666666">
                            <Border Background="White" BorderBrush="#E5E5E5" BorderThickness="1"
                                    CornerRadius="4" Margin="0,8,0,0">
                                <TextBox Text="{Binding StackTrace, FallbackValue='Custom StackTrace Custom StackTrace', Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="Transparent" BorderThickness="0"
                                         TextWrapping="Wrap" MaxHeight="200"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="10" FontSize="12" FontFamily="Cascadia Code, Consolas"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentToast}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="20"/>
    </Grid>
</Window>