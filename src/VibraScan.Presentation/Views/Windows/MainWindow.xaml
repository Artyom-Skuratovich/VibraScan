<Window
    x:Class="VibraScan.Presentation.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrls="clr-namespace:VibraScan.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibraScan.Presentation.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels"
    Title="MainWindow"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Grid>
        <TabControl Style="{StaticResource FluentTabControl}">
            <TabItem Header="Графики">
                <ctrls:ChartsView DataContext="{Binding ChartsVm}" />
            </TabItem>
            <TabItem Header="Мониторинг">
                <ctrls:MonitoringView DataContext="{Binding MonitoringVm}" />
            </TabItem>
            <TabItem Header="Импорт">
                <ctrls:DataImportView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>