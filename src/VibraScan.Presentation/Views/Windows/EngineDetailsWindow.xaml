<Window
    x:Class="VibraScan.Presentation.Views.Windows.EngineDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibraScan.Presentation.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EngineDetailsWindow"
    Width="850"
    Height="540"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Шапка  -->
            <RowDefinition Height="*" />
            <!--  Форма редактирования  -->
            <RowDefinition Height="Auto" />
            <!--  Подвал с кнопками  -->
        </Grid.RowDefinitions>

        <!--  ================= ШАПКА ОКНА =================  -->
        <Border
            Grid.Row="0"
            Padding="24,20"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="Редактирование parameters и правил" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock
                        FontSize="13"
                        Foreground="#64748B"
                        Text="Цех: " />
                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="#334155"
                        Text="Компрессорный цех №3" />
                    <Separator Margin="12,2" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <TextBlock
                        FontSize="13"
                        Foreground="#64748B"
                        Text="ID оборудования: " />
                    <TextBlock
                        FontSize="13"
                        Foreground="#334155"
                        Text="10245" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  ================= ФОРМА РЕДАКТИРОВАНИЯ =================  -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <!--  Левая часть: Состояние и Даты  -->
                <ColumnDefinition Width="1.2*" />
                <!--  Правая часть: Правила проверки  -->
            </Grid.ColumnDefinitions>

            <!--  ЛЕВАЯ КОЛОНКА: Состояние и Даты  -->
            <Border
                Grid.Column="0"
                Margin="0,0,12,0"
                Padding="20"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.02"
                        ShadowDepth="1"
                        Color="Black" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#94A3B8"
                        Text="ОСНОВНЫЕ ПАРАМЕТРЫ"
                        Typography.Capitals="AllSmallCaps" />

                    <!--  Название двигателя  -->
                    <TextBlock
                        Margin="2,0,0,6"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="#64748B"
                        Text="Название двигателя" />
                    <TextBox
                        Margin="0,0,0,16"
                        Style="{StaticResource FluentTextBox}"
                        Text="Асинхронный АИР132М4" />

                    <!--  Выбор состояния (Condition)  -->
                    <TextBlock
                        Margin="2,0,0,6"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="#64748B"
                        Text="Текущее состояние" />
                    <ComboBox
                        Margin="0,0,0,16"
                        SelectedIndex="1"
                        Style="{StaticResource FluentComboBox}">
                        <ComboBoxItem Content="Отлично" />
                        <ComboBoxItem Content="Удовлетворительно" />
                        <ComboBoxItem Content="Не удовлетворительно" />
                        <ComboBoxItem Content="Плохо" />
                        <ComboBoxItem Content="Не удалось проверить" />
                    </ComboBox>

                    <!--  Дата последней проверки  -->
                    <TextBlock
                        Margin="2,0,0,6"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="#64748B"
                        Text="Дата последней проверки" />
                    <DatePicker
                        Margin="0,0,0,16"
                        Style="{StaticResource FluentDatePicker}"
                        Text="15.07.2026" />

                    <!--  Дата следующей проверки  -->
                    <TextBlock
                        Margin="2,0,0,6"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="#64748B"
                        Text="Дата следующей проверки" />
                    <DatePicker Style="{StaticResource FluentDatePicker}" Text="15.10.2026" />
                </StackPanel>
            </Border>

            <!--  ПРАВАЯ КОЛОНКА: Правило и Интервалы  -->
            <Border
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="20"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.02"
                        ShadowDepth="1"
                        Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  Заголовки и Выбор правила  -->
                        <RowDefinition Height="*" />
                        <!--  Список интервалов  -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#94A3B8"
                            Text="ПРАВИЛО И ИНТЕРВАЛЫ ПРОВЕРОК"
                            Typography.Capitals="AllSmallCaps" />

                        <!--  Выбор правила проверки через ComboBox  -->
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="#64748B"
                            Text="Выбор правила инспекции" />
                        <ComboBox
                            Margin="0,0,0,16"
                            SelectedIndex="0"
                            Style="{StaticResource FluentComboBox}">
                            <ComboBoxItem Content="Стандартный регламент (DEFAULT)" />
                            <ComboBoxItem Content="Усиленный контроль (Критические узлы)" />
                            <ComboBoxItem Content="Регламент выходного дня" />
                        </ComboBox>

                        <TextBlock
                            Margin="2,0,0,8"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Дней до следующей проверки при статусе:" />
                    </StackPanel>

                    <!--  Демонстрационный статичный список интервалов  -->
                    <ScrollViewer
                        Grid.Row="1"
                        Focusable="False"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">

                            <!--  Отлично  -->
                            <Border
                                Padding="0,6"
                                BorderBrush="#F1F5F9"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Margin="2,0,10,0"
                                            Fill="#22C55E" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#334155"
                                            Text="Отлично" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox
                                            Width="60"
                                            Height="28"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Style="{StaticResource FluentTextBox}"
                                            Text="90" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#64748B"
                                            Text="дн." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Удовлетворительно  -->
                            <Border
                                Padding="0,6"
                                BorderBrush="#F1F5F9"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Margin="2,0,10,0"
                                            Fill="#EAB308" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#334155"
                                            Text="Удовлетворительно" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox
                                            Width="60"
                                            Height="28"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Style="{StaticResource FluentTextBox}"
                                            Text="45" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#64748B"
                                            Text="дн." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Не удовлетворительно  -->
                            <Border
                                Padding="0,6"
                                BorderBrush="#F1F5F9"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Margin="2,0,10,0"
                                            Fill="#F97316" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>