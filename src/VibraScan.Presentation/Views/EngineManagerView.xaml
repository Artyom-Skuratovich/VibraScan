<UserControl x:Class="VibraScan.Presentation.Views.EngineManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VibraScan.Presentation.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:h="clr-namespace:VibraScan.Presentation.Infrastructure.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Фильтры -->
            <RowDefinition Height="*"/>
            <!-- Плитка -->
            <RowDefinition Height="Auto"/>
            <!-- Инфо-панель -->
        </Grid.RowDefinitions>

        <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ -->
        <Border Background="#F8FAFC" Padding="20" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
            <StackPanel>
                <!-- Шапка -->
                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Мониторинг состояния двигателей цеха" 
                                   FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Цех:" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="150" Height="28" Margin="8,0,0,0"/>

                            <Border Background="#F1F5F9" CornerRadius="4" Margin="10,0,0,0" Padding="8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Текущий: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="2A" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ToggleButton x:Name="MultiSelectToggle" Height="30" Padding="10,0" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Выделить несколько" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <Button Content="Действия" Margin="8,0,0,0" Height="30" Padding="15,0"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Visibility="{Binding IsChecked, ElementName=MultiSelectToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Button.RenderTransform>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Панель инструментов -->
                <Border Background="White" CornerRadius="4" BorderThickness="1" BorderBrush="#E2E8F0" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <!-- Название -->
                                <ColumnDefinition Width="1*"/>
                                <!-- Состояние -->
                                <ColumnDefinition Width="2.5*"/>
                                <!-- Даты (увеличено) -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Кнопка -->
                            </Grid.ColumnDefinitions>

                            <!-- Название -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Название" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox h:TextBoxHelper.Placeholder="Поиск..." Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Состояние -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Состояние" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox Height="30" Style="{StaticResource DarkComboBoxStyle}"/>
                            </StackPanel>

                            <!-- Период -->
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Последняя проверка" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" Height="30"/>
                                    <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Margin="6,0" Foreground="#CBD5E1"/>
                                    <DatePicker Grid.Column="2" Height="30"/>
                                </Grid>
                            </StackPanel>

                            <!-- Кнопка Найти (Компактная) -->
                            <Button Grid.Column="3" VerticalAlignment="Bottom" Height="30" Padding="15,0"
                            Background="#2563EB" Foreground="White" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Найти" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Легенда -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="СТАТУСЫ" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <ItemsControl>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <!-- Элементы легенды в стиле "Pill" или точка -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center"/>
                                    <TextBlock Text="Отлично" Margin="6,0,0,0" FontSize="11" Foreground="#475569"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="6" Height="6" Fill="#EAB308" VerticalAlignment="Center"/>
                                    <TextBlock Text="Удовл." Margin="6,0,0,0" FontSize="11" Foreground="#475569"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="6" Height="6" Fill="#F97316" VerticalAlignment="Center"/>
                                    <TextBlock Text="Неудовл." Margin="6,0,0,0" FontSize="11" Foreground="#475569"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center"/>
                                    <TextBlock Text="Плохо" Margin="6,0,0,0" FontSize="11" Foreground="#475569"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#3B82F6" VerticalAlignment="Center"/>
                                    <TextBlock Text="Нет данных" Margin="6,0,0,0" FontSize="11" Foreground="#475569"/>
                                </StackPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 2. ОБЛАСТЬ КАРТОЧЕК -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <WrapPanel Margin="20">

                <!-- КАРТОЧКА С РЕЖИМОМ ВЫБОРА -->
                <Grid Margin="0,0,15,15">
                    <Border x:Name="EngineCard" Width="170" Height="100" CornerRadius="10" 
                        Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <!-- Эффект сжатия (iPhone style) -->
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=MultiSelectToggle}" Value="True">
                                        <Setter Property="Width" Value="155"/>
                                        <Setter Property="Height" Value="90"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Двигатель A-101" FontWeight="Bold" FontSize="13" Foreground="#166534" HorizontalAlignment="Center"/>
                            <TextBlock Text="12.04.2024" FontSize="10" Foreground="#166534" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Кружок выбора слева сверху -->
                    <CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0"
                          Visibility="{Binding IsChecked, ElementName=MultiSelectToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Grid x:Name="CheckGrid" Width="24" Height="24" Cursor="Hand">
                                                <!-- Пустой кружок -->
                                                <Ellipse x:Name="Bg" Fill="White" Stroke="#CBD5E1" StrokeThickness="2"/>
                                                <!-- Галочка (скрыта) -->
                                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" 
                                                       Foreground="White" FontSize="12" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Fill" Value="#2563EB"/>
                                                    <Setter TargetName="Bg" Property="Stroke" Value="#2563EB"/>
                                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>

                <!-- Повторить такие блоки для остальных карточек -->
            </WrapPanel>
        </ScrollViewer>

        <!-- 3. СТРОКА СОСТОЯНИЯ -->
        <Border Grid.Row="2" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="20,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Всего объектов: 48" Foreground="#64748B" FontSize="12"/>
                    <Separator Margin="15,2" Background="#E2E8F0"/>
                    <TextBlock Text="Требуют срочной проверки: 5" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="Обновлено: 15:30" Foreground="#94A3B8" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>

