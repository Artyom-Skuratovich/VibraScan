<UserControl
    x:Class="VibraScan.Presentation.Views.ChartsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:VibraScan.Presentation.Common.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VibraScan.Presentation.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ChartsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Background="#F1F5F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="20,24"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,1,0">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="Вибродиагностика" />
                    <TextBlock
                        Margin="0,0,0,24"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="Параметры анализа двигателя" />

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Цех" />
                        <ComboBox
                            ItemsSource="{Binding Workshops}"
                            SelectedItem="{Binding CurrentWorkshop}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите цех --">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Двигатель" />
                        <ComboBox
                            IsEnabled="{Binding IsWorkshopSelected}"
                            ItemsSource="{Binding Engines}"
                            SelectedItem="{Binding SelectedEngine}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите двигатель --">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Точка измерения" />
                        <ComboBox
                            IsEnabled="{Binding IsEngineSelected}"
                            ItemsSource="{Binding Points}"
                            SelectedItem="{Binding SelectedPoint}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите точку --">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Ось измерения" />
                        <ComboBox
                            IsEnabled="{Binding IsPointSelected}"
                            ItemsSource="{Binding AxisTypes}"
                            SelectedItem="{Binding SelectedAxisType}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите ось измерения --" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Параметры измерения" />
                        <ComboBox
                            IsEnabled="{Binding IsAxisTypeSelected}"
                            ItemsSource="{Binding MeasurementProfiles}"
                            SelectedItem="{Binding SelectedMeasurementProfile}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите параметр --">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer
            Grid.Column="1"
            Background="White"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <DockPanel Margin="8,0,8,24" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#64748B"
                            Text="Выберите дату замера для отображения" />
                        <ComboBox
                            MinWidth="200"
                            IsEnabled="{Binding IsMeasurementProfileSelected}"
                            ItemStringFormat="dd.MM.yyyy HH:mm:ss"
                            ItemsSource="{Binding MeasurementDates}"
                            SelectedItem="{Binding SelectedMeasurementDate}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите дату --" />
                    </StackPanel>
                </DockPanel>

                <UniformGrid
                    x:Name="ChartsContainer"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Columns" Value="2" />
                            <Setter Property="Rows" Value="1" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=ChartsContainer, Converter={StaticResource WidthToLayConverter}}" Value="True">
                                    <Setter Property="Columns" Value="1" />
                                    <Setter Property="Rows" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <ContentControl
                        Margin="12"
                        Content="{Binding TimeDomainChart}"
                        ContentTemplate="{StaticResource ChartCardTemplate}" />

                    <ContentControl
                        Margin="12"
                        Content="{Binding FrequencyDomainChart}"
                        ContentTemplate="{StaticResource ChartCardTemplate}" />
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>