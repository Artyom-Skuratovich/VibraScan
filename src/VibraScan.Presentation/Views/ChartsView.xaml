<UserControl
    x:Class="VibraScan.Presentation.Views.ChartsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VibraScan.Presentation.Views"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ChartsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadWorkshopsCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Background="#F1F5F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="20,24"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,1,0">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="Вибродиагностика" />
                    <TextBlock
                        Margin="0,0,0,24"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="Параметры анализа сигнала" />

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Цех" />
                        <ComboBox
                            ItemsSource="{Binding Workshops}"
                            SelectedItem="{Binding CurrentWorkshop}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите цех --">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Двигатель" />
                        <ComboBox
                            ItemsSource="{Binding Engines}"
                            SelectedItem="{Binding SelectedEngine}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите двигатель --">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Точка измерения" />
                        <ComboBox
                            ItemsSource="{Binding Points}"
                            SelectedItem="{Binding SelectedPoint}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите точку --" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Ось измерения" />
                        <ComboBox
                            ItemsSource="{Binding Axes}"
                            SelectedItem="{Binding SelectedAxis}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите ось --" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Параметры" />
                        <ComboBox
                            ItemsSource="{Binding Parameters}"
                            SelectedItem="{Binding SelectedParameter}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Настройка параметров --" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer
            Grid.Column="1"
            Background="White"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <DockPanel Margin="8,0,8,24" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#64748B"
                            Text="Выберите дату замера для отображения" />
                        <ComboBox
                            MinWidth="200"
                            ItemsSource="{Binding MeasurementDates}"
                            SelectedItem="{Binding SelectedDate}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите дату --" />
                    </StackPanel>
                </DockPanel>

                <WrapPanel Orientation="Horizontal">

                    <Grid
                        Width="470"
                        Height="340"
                        Margin="8">

                        <Border
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="12"
                                    Opacity="0.03"
                                    RenderingBias="Performance"
                                    ShadowDepth="1"
                                    Color="Black" />
                            </Border.Effect>
                        </Border>

                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Left">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="#64748B"
                                    Text="RMS" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#0F172A"
                                    Text="24.55" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,12"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#0F172A"
                                Text="Временная область" />

                            <lvc:CartesianChart
                                Grid.Row="2"
                                Series="{Binding TimeDomainSeries}"
                                TooltipPosition="Top" />
                        </Grid>
                    </Grid>

                    <Border
                        Width="470"
                        Height="340"
                        Margin="8"
                        Padding="20"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Opacity="0.03"
                                ShadowDepth="1"
                                Color="Black" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <!--  Метрики (TP-P)  -->
                                <RowDefinition Height="Auto" />
                                <!--  Название  -->
                                <RowDefinition Height="*" />
                                <!--  График  -->
                            </Grid.RowDefinitions>

                            <!--  Справа сверху: Метрика TP-P  -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Right">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="#64748B"
                                    Text="TP-P" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#0F172A"
                                    Text="{Binding TppValue, FallbackValue='12.80'}" />
                            </StackPanel>

                            <!--  Название графика черным жирным  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,12,0,12"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#0F172A"
                                Text="Частотная область" />

                            <!--  Объемный График (Синий)  -->
                            <lvc:CartesianChart
                                Grid.Row="2"
                                Series="{Binding FrequencyDomainSeries}"
                                TooltipPosition="Top"
                                XAxes="{Binding FreqXAxes}"
                                YAxes="{Binding CommonYAxes}" />
                        </Grid>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>