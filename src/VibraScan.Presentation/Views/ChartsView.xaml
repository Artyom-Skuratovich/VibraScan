<UserControl x:Class="VibraScan.Presentation.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VibraScan.Presentation.Views"
             xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ChartsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.Resources>
        <ResourceDictionary>
            <DrawingBrush x:Key="HatchedBrush"
              TileMode="Tile"
              Viewport="0,0,20,20"
              ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#F5F5F5">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,20,20"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>

                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#E0E0E0" Thickness="1"/>
                            </GeometryDrawing.Pen>

                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="0,20" EndPoint="20,0"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#212529">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Height="35" Padding="15,0">
                    <TextBlock Text="КРИТЕРИИ ВЫБОРА"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="#ADB5BD"
                               FontSize="11"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="White">
                    <Grid Margin="30">
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldHeaderStyle}">
                                <Setter Property="Foreground" Value="#ADB5BD"/>
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="20" MaxHeight="50"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="20" MaxHeight="50"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="20" MaxHeight="50"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="20" MaxHeight="50"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Цех"/>
                        <ComboBox Grid.Row="2" Style="{StaticResource DarkComboBoxStyle}"/>

                        <TextBlock Grid.Row="4" Text="Двигатель"/>
                        <ComboBox Grid.Row="6" Style="{StaticResource DarkComboBoxStyle}"/>

                        <TextBlock Grid.Row="8" Text="Точка измерения"/>
                        <ComboBox Grid.Row="10" Style="{StaticResource DarkComboBoxStyle}"/>

                        <TextBlock Grid.Row="12" Text="Ось"/>
                        <ComboBox Grid.Row="14" Style="{StaticResource DarkComboBoxStyle}"/>

                        <TextBlock Grid.Row="16" Text="Параметр"/>
                        <ComboBox Grid.Row="18" Style="{StaticResource DarkComboBoxStyle}"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2" x:Name="ChartsParentContainer">
            <Border Background="{StaticResource HatchedBrush}"/>

            <Border x:Name="ChartCard"
            Background="White"
            CornerRadius="4"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            Margin="15"
            Visibility="{Binding IsChartsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="450"/>
                        <Setter Property="Height" Value="350"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ExpandBtn}" Value="True">
                                <Setter Property="Width" Value="{Binding ActualWidth, ElementName=ChartsParentContainer, ConverterParameter=30}"/>
                                <Setter Property="Height" Value="{Binding ActualHeight, ElementName=ChartsParentContainer, ConverterParameter=30}"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="15"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F8F9FA" CornerRadius="4,4,0,0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <DockPanel Margin="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedEngine.Name, FallbackValue='Двигатель не выбран'}"
                                           Style="{StaticResource FieldHeaderStyle}"
                                           VerticalAlignment="Center" FontWeight="Bold" Foreground="#495057"/>
                                <TextBlock Text=": "
                                           Style="{StaticResource FieldHeaderStyle}"
                                           FontWeight="Bold" Foreground="#495057"/>
                                <TextBlock Text="{Binding SelectedMeasurementDate, StringFormat='{}{0:dd.MM.yyyy}', FallbackValue='--.--.----'}"
                                           Style="{StaticResource FieldHeaderStyle}"
                                           FontWeight="Bold" Foreground="#495057"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="ExpandBtn" 
                                              Background="Transparent" 
                                              BorderThickness="0" 
                                              Width="30">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Content" Value="&#xE922;"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="&#xE923;"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Button Command="{Binding CloseChartsCommand}" Background="Transparent" BorderThickness="0" Width="30">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="20,15,20,10" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource FieldHeaderStyle}"
                                       Text="Дата замера"
                                       Foreground="#6C757D"
                                       Margin="0,0,0,5"/>

                            <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                      ItemsSource="{Binding MeasurementDates}"
                                      SelectedItem="{Binding SelectedMeasurementDate}"
                                      Width="200">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0:dd.MM.yyyy HH:mm:ss-ffffff}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <GridSplitter Grid.Row="1" Width="4" HorizontalAlignment="Right" Background="#F0F0F0" Cursor="SizeWE"/>
                    <GridSplitter Grid.Row="1" Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#F0F0F0" Cursor="SizeNS"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>