<UserControl
    x:Class="VibraScan.Presentation.Views.ChartsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:VibraScan.Presentation.Common.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VibraScan.Presentation.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ChartsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Background="#F1F5F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="20,24"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,1,0">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#0F172A"
                            Text="Вибродиагностика" />

                        <Button
                            Grid.Column="1"
                            Padding="6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding LoadWorkshopsCommand}"
                            Cursor="Hand"
                            ToolTip="Обновить списки цехов и оборудования">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="BtnBorder"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent"
                                                    CornerRadius="6">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0" />
                                                    </Trigger>

                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                            <Viewbox Width="16" Height="16">
                                <Path
                                    Data="M 12.5,4.5 C 11.23,3.23 9.46,2.5 7.5,2.5 3.91,2.5 1,5.41 1,9 c 0,3.59 2.91,6.5 6.5,6.5 2.87,0 5.3,-1.86 6.16,-4.43 M 14,1.5 l 0,4.5 -4.5,0"
                                    Stroke="#64748B"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Viewbox>
                        </Button>
                    </Grid>

                    <TextBlock
                        Margin="0,0,0,24"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="Параметры анализа двигателя" />

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Цех" />
                        <ComboBox
                            ItemsSource="{Binding Workshops}"
                            SelectedItem="{Binding CurrentWorkshop}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите цех --">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Двигатель" />
                        <ComboBox
                            IsEnabled="{Binding IsWorkshopSelected}"
                            ItemsSource="{Binding Engines}"
                            SelectedItem="{Binding SelectedEngine}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите двигатель --">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Точка измерения" />
                        <ComboBox
                            IsEnabled="{Binding IsEngineSelected}"
                            ItemsSource="{Binding Points}"
                            SelectedItem="{Binding SelectedPoint}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите точку --">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Ось измерения" />
                        <ComboBox
                            IsEnabled="{Binding IsPointSelected}"
                            ItemsSource="{Binding AxisTypes}"
                            SelectedItem="{Binding SelectedAxisType}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите ось измерения --" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="Параметры измерения" />
                        <ComboBox
                            IsEnabled="{Binding IsAxisTypeSelected}"
                            ItemsSource="{Binding MeasurementProfiles}"
                            SelectedItem="{Binding SelectedMeasurementProfile}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите параметр --">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer
            Grid.Column="1"
            Background="White"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <DockPanel Margin="8,0,8,24" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock
                            Margin="2,0,0,6"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#64748B"
                            Text="Выберите дату замера для отображения" />
                        <ComboBox
                            MinWidth="200"
                            IsEnabled="{Binding IsMeasurementProfileSelected}"
                            ItemStringFormat="dd.MM.yyyy HH:mm:ss"
                            ItemsSource="{Binding MeasurementDates}"
                            SelectedItem="{Binding SelectedMeasurementDate}"
                            Style="{StaticResource FluentComboBox}"
                            Tag="-- Выберите дату --" />
                    </StackPanel>
                </DockPanel>

                <UniformGrid
                    x:Name="ChartsContainer"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Columns" Value="2" />
                            <Setter Property="Rows" Value="1" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=ChartsContainer, Converter={StaticResource WidthToLayConverter}}" Value="True">
                                    <Setter Property="Columns" Value="1" />
                                    <Setter Property="Rows" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <ContentControl
                        Margin="12"
                        Content="{Binding TimeDomain}"
                        ContentTemplate="{StaticResource ChartBundleTemplate}" />

                    <ContentControl
                        Margin="12"
                        Content="{Binding FrequencyDomain}"
                        ContentTemplate="{StaticResource ChartBundleTemplate}" />
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>