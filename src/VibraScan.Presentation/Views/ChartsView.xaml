<UserControl
    x:Class="VibraScan.Presentation.Views.ChartsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibraScan.Presentation.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ChartsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <DrawingBrush
                x:Key="HatchedBrush"
                TileMode="Tile"
                Viewport="0,0,20,20"
                ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#F5F5F5">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,20,20" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>

                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#E0E0E0" Thickness="1" />
                            </GeometryDrawing.Pen>

                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="0,20" EndPoint="20,0" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Margin="0,0,0,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#212529">
            <DockPanel LastChildFill="True">
                <Border
                    Height="35"
                    Padding="15,0"
                    DockPanel.Dock="Top">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#ADB5BD"
                        Text="КРИТЕРИИ ВЫБОРА" />
                </Border>

                <ScrollViewer Foreground="White" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="30">
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#ADB5BD" />
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition
                                Height="*"
                                MinHeight="20"
                                MaxHeight="50" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition
                                Height="*"
                                MinHeight="20"
                                MaxHeight="50" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition
                                Height="*"
                                MinHeight="20"
                                MaxHeight="50" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition
                                Height="*"
                                MinHeight="20"
                                MaxHeight="50" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Цех" />
                        <ComboBox Grid.Row="2" />

                        <TextBlock Grid.Row="4" Text="Двигатель" />
                        <ComboBox Grid.Row="6" />

                        <TextBlock Grid.Row="8" Text="Точка измерения" />
                        <ComboBox Grid.Row="10" />

                        <TextBlock Grid.Row="12" Text="Ось" />
                        <ComboBox Grid.Row="14" />

                        <TextBlock Grid.Row="16" Text="Параметр" />
                        <ComboBox Grid.Row="18" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid x:Name="ChartsParentContainer" Grid.Column="2">
            <Border Background="{StaticResource HatchedBrush}" />

            <Border
                x:Name="ChartCard"
                Margin="15"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="White"
                CornerRadius="4"
                Visibility="{Binding IsChartsVisible, Converter={StaticResource BoolToVis}}">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="450" />
                        <Setter Property="Height" Value="350" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ExpandBtn}" Value="True">
                                <Setter Property="Width" Value="{Binding ActualWidth, ElementName=ChartsParentContainer, ConverterParameter=30}" />
                                <Setter Property="Height" Value="{Binding ActualHeight, ElementName=ChartsParentContainer, ConverterParameter=30}" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="15" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="20"
                        Opacity="0.2"
                        ShadowDepth="0" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Background="#F8F9FA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        CornerRadius="4,4,0,0">
                        <DockPanel Margin="10,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="#495057"
                                    Text="{Binding SelectedEngine.Name, FallbackValue='Двигатель не выбран'}" />
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="#495057"
                                    Text=": " />
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="#495057"
                                    Text="{Binding SelectedMeasurementDate, StringFormat='{}{0:dd.MM.yyyy}', FallbackValue='--.--.----'}" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ToggleButton
                                    x:Name="ExpandBtn"
                                    Width="30"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <ToggleButton.Style>
                                        <Style BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="ToggleButton">
                                            <Setter Property="Content" Value="&#xE922;" />
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="&#xE923;" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Text="{TemplateBinding Content}" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Button
                                    Width="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding CloseChartsCommand}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        Text="&#xE8BB;" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="119*" />
                            <ColumnDefinition Width="106*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,15,0,10"
                            HorizontalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,5"
                                Foreground="#6C757D"
                                Text="Дата замера" />

                            <ComboBox
                                Width="200"
                                ItemsSource="{Binding MeasurementDates}"
                                SelectedItem="{Binding SelectedMeasurementDate}">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0:dd.MM.yyyy HH:mm:ss-ffffff}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <ScrollViewer
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20" />
                        </ScrollViewer>
                    </Grid>

                    <GridSplitter
                        Grid.Row="1"
                        Width="4"
                        HorizontalAlignment="Right"
                        Background="#F0F0F0"
                        Cursor="SizeWE" />
                    <GridSplitter
                        Grid.Row="1"
                        Height="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="#F0F0F0"
                        Cursor="SizeNS" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>