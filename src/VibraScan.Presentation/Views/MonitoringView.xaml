<UserControl x:Class="VibraScan.Presentation.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ges="clr-namespace:VibraScan.Application.Engines.Queries.GetEngines;assembly=VibraScan.Application"
             xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonitoringViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DataTemplates/EngineBriefCard.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#F8FAFC" 
            Padding="24" 
            BorderThickness="0,0,0,1" 
            BorderBrush="#E2E8F0">
            <StackPanel>
                <DockPanel LastChildFill="False" 
                       Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Мониторинг состояния двигателей цеха"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0">
                            <TextBlock Text="Цех:"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   FontSize="13"/>

                            <ComboBox Style="{StaticResource FluentComboBox}"
                                      ItemsSource="{Binding Workshops}"
                                      SelectedItem="{Binding CurrentWorkshop}"
                                      Tag="-- Выберите цех --"
                                      MinWidth="160"
                                      Margin="8,0,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Border Background="#E2E8F0"
                                    CornerRadius="5"
                                    Margin="12,0,0,0"
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    Height="26">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Текущий: "
                                               FontSize="11"
                                               Foreground="#475569"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding CurrentWorkshop.Name, FallbackValue='—', TargetNullValue='—'}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                        <ToggleButton Style="{StaticResource FluentSecondaryToggleButton}"
                                  x:Name="MultiSelectToggle"
                                  Padding="16,0"
                                  Height="35">
                            <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE762;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Выделить несколько"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <Button Style="{StaticResource FluentPrimaryButton}"
                            Content="Действия" 
                            Margin="8,0,0,0"
                            Padding="20,0" Height="35"
                            Visibility="{Binding IsChecked, ElementName=MultiSelectToggle, Converter={StaticResource BoolToVis}}">
                            <Button.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Button.RenderTransform>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Border Background="White"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="#E2E8F0"
                    Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="1"
                                      Opacity="0.03"
                                      Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Название"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="#64748B"
                                       Margin="2,0,0,6"/>
                                <TextBox Style="{StaticResource FluentTextBox}"
                                         Text="{Binding SearchText}"
                                         Tag="-- Введите название --"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Состояние"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="#64748B"
                                       Margin="2,0,0,6"/>
                                <ComboBox Style="{StaticResource FluentComboBox}"
                                          ItemsSource="{Binding AvailableConditions}"
                                          SelectedItem="{Binding SelectedCondition}"
                                          Tag="-- Выберите состояние --"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <!--<TextBlock Text="Последняя проверка"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="#64748B"
                                       Margin="2,0,0,6"/>-->

                                <!--<ComboBox Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="12"
                                          FontWeight="Medium"
                                          Foreground="#64748B"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,0,6"
                                          Padding="2,0,0,0"
                                          SelectedValue="{Binding SelectedDateType}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Последняя проверка" Tag="{x:Static ges:InspectionDateType.LastInspection}"/>
                                    <ComboBoxItem Content="Следующая проверка" Tag="{x:Static ges:InspectionDateType.NextInspection}"/>
                                </ComboBox>-->

                                <ComboBox Style="{StaticResource FluentComboBoxBadge}"
                                          SelectedValue="{Binding SelectedDateType}"
                                          SelectedValuePath="Tag"
                                          FontSize="12"
                                          FontWeight="Medium"
                                          Foreground="#64748B"
                                          HorizontalAlignment="Left"
                                          Margin="2,0,0,6">
                                    <ComboBoxItem Content="Последняя проверка" Tag="{x:Static ges:InspectionDateType.LastInspection}"/>
                                    <ComboBoxItem Content="Следующая проверка" Tag="{x:Static ges:InspectionDateType.NextInspection}"/>
                                </ComboBox>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePicker Style="{StaticResource FluentDatePicker}"
                                                Grid.Column="0"
                                                SelectedDate="{Binding DateFrom}"
                                                Tag="-- От --"/>

                                    <TextBlock Grid.Column="1"
                                               Text="—"
                                               VerticalAlignment="Center"
                                               Margin="8,0" Foreground="#94A3B8"
                                               FontWeight="Light"/>

                                    <DatePicker Style="{StaticResource FluentDatePicker}"
                                                Grid.Column="2"
                                                SelectedDate="{Binding DateTo}"
                                                Tag="-- До --"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Grid.IsSharedSizeScope="True" Margin="0,0,16,0">
                                <StackPanel.Resources>
                                    <Style TargetType="RadioButton" BasedOn="{StaticResource FluentRadioButton}">
                                        <Setter Property="GroupName" Value="InspectionFilter"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InspectionFilterGroup"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Content="{Binding}" HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </StackPanel.Resources>

                                <TextBlock Text="Срок проверки"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#64748B"
                                           Margin="2,0,0,6"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <RadioButton Content="Всё"
                                                 IsChecked="{Binding SelectedInspectionFilter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static ges:InspectionStatusFilter.All}}"/>

                                    <RadioButton Content="Истёк"
                                                 IsChecked="{Binding SelectedInspectionFilter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static ges:InspectionStatusFilter.Overdue}}"/>

                                    <RadioButton Content="В норме" Margin="0"
                                                 IsChecked="{Binding SelectedInspectionFilter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static ges:InspectionStatusFilter.Valid}}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Style="{StaticResource FluentPrimaryButton}" 
                                    Grid.Column="4" 
                                    VerticalAlignment="Bottom"
                                    Padding="24,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="Найти"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="2,20,0,0">
                            <TextBlock Text="СТАТУСЫ"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Typography.Capitals="AllSmallCaps"/>

                            <ItemsControl>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.Items>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center"/>
                                        <TextBlock Text="Отлично" Margin="8,0,0,0" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <Ellipse Width="6" Height="6" Fill="#EAB308" VerticalAlignment="Center"/>
                                        <TextBlock Text="Удовл." Margin="8,0,0,0" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <Ellipse Width="6" Height="6" Fill="#F97316" VerticalAlignment="Center"/>
                                        <TextBlock Text="Неудовл." Margin="8,0,0,0" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock Text="Плохо" Margin="8,0,0,0" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#3B82F6" VerticalAlignment="Center"/>
                                        <TextBlock Text="Нет данных" Margin="8,0,0,0" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                </ItemsControl.Items>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl Margin="20" ItemsSource="{Binding Engines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="4"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>

        <!-- 3. СТРОКА СОСТОЯНИЯ -->
        <Border Grid.Row="2" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="20,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Всего объектов: 48" Foreground="#64748B" FontSize="12"/>
                    <Separator Margin="15,2" Background="#E2E8F0"/>
                    <TextBlock Text="Требуют срочной проверки: 5" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="Обновлено: 15:30" Foreground="#94A3B8" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>