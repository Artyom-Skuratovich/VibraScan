<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FluentProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#2563EB" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Value}" Value="0">
                <DataTrigger.EnterActions>
                    <StopStoryboard BeginStoryboardName="SmoothProgressStoryboard" />
                </DataTrigger.EnterActions>

                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="SmoothProgressStoryboard">
                        <Storyboard>
                            <DoubleAnimation
                                DecelerationRatio="0.2"
                                Storyboard.TargetProperty="Value"
                                Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>