<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FluentButtonBase" TargetType="{x:Type ButtonBase}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="24,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="ButtonWrapper"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">

                        <ContentPresenter
                            x:Name="PART_ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="FluentPrimaryButton"
        BasedOn="{StaticResource FluentButtonBase}"
        TargetType="{x:Type ButtonBase}">
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1D4ED8" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#1E40AF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#EFF6FF" />
                <Setter Property="Foreground" Value="#93C5FD" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="FluentSecondaryButton"
        BasedOn="{StaticResource FluentButtonBase}"
        TargetType="{x:Type ButtonBase}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="BorderBrush" Value="#475569" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F8FAFC" />
                <Setter Property="BorderBrush" Value="#1E293B" />
                <Setter Property="Foreground" Value="#0F172A" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#E2E8F0" />
                <Setter Property="BorderBrush" Value="#1E293B" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="Foreground" Value="#94A3B8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="FluentPrimaryToggleButton"
        BasedOn="{StaticResource FluentPrimaryButton}"
        TargetType="ToggleButton">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#1D4ED8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#1E40AF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="FluentSecondaryToggleButton"
        BasedOn="{StaticResource FluentSecondaryButton}"
        TargetType="ToggleButton">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#F1F5F9" />
                <Setter Property="BorderBrush" Value="#1E293B" />
                <Setter Property="Foreground" Value="#2563EB" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="FluentRadioButton"
        BasedOn="{StaticResource FluentButtonBase}"
        TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />

        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#E2E8F0" />
                <Setter Property="Foreground" Value="#1E293B" />
            </MultiTrigger>

            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#1E293B" />
                <Setter Property="Foreground" Value="#2563EB" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#F8FAFC" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#CBD5E1" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Viewbox
        x:Key="RefreshIconGeometry"
        Width="16"
        Height="16"
        x:Shared="False">
        <Path
            Data="M 12.5,4.5 C 11.23,3.23 9.46,2.5 7.5,2.5 3.91,2.5 1,5.41 1,9 c 0,3.59 2.91,6.5 6.5,6.5 2.87,0 5.3,-1.86 6.16,-4.43 M 14,1.5 l 0,4.5 -4.5,0"
            Stroke="#64748B"
            StrokeEndLineCap="Round"
            StrokeLineJoin="Round"
            StrokeStartLineCap="Round"
            StrokeThickness="1.5" />
    </Viewbox>

    <Style x:Key="RefreshButton" TargetType="Button">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />

        <Setter Property="Content" Value="{DynamicResource RefreshIconGeometry}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="BtnBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>