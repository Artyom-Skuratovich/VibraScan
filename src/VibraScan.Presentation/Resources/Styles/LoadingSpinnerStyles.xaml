<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SpinnerCircleStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="#007ACC"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Unspecified" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <Style x:Key="SpinnerOrbitStyle" TargetType="Grid">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0"/>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SpinnerTemplate">
        <ControlTemplate.Resources>

        </ControlTemplate.Resources>

        <Viewbox Width="100" Height="100">
            <Canvas Width="100" Height="100" CacheMode="BitmapCache">

                <Grid x:Name="C1" Style="{StaticResource SpinnerOrbitStyle}">
                    <Ellipse Style="{StaticResource SpinnerCircleStyle}"/>
                </Grid>

                <Grid x:Name="C2" Style="{StaticResource SpinnerOrbitStyle}">
                    <Ellipse Style="{StaticResource SpinnerCircleStyle}"/>
                </Grid>

                <Grid x:Name="C3" Style="{StaticResource SpinnerOrbitStyle}">
                    <Ellipse Style="{StaticResource SpinnerCircleStyle}"/>
                </Grid>

                <Grid x:Name="C4" Style="{StaticResource SpinnerOrbitStyle}">
                    <Ellipse Style="{StaticResource SpinnerCircleStyle}"/>
                </Grid>

                <Grid x:Name="C5" Style="{StaticResource SpinnerOrbitStyle}">
                    <Ellipse Style="{StaticResource SpinnerCircleStyle}"/>
                </Grid>

                <Canvas.Resources>
                    <Storyboard x:Key="SpinAnim" RepeatBehavior="Forever">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)" Duration="0:0:2.5">
                            <DoubleAnimationUsingKeyFrames.KeyFrames>
                                <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="360" KeySpline="0.4,0,0.2,1"/>
                            </DoubleAnimationUsingKeyFrames.KeyFrames>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </Canvas.Resources>

            </Canvas>
        </Viewbox>

        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                <DataTrigger.EnterActions>
                    <ResumeStoryboard BeginStoryboardName="SpinBegin"/>
                    <BeginStoryboard x:Name="SpinBegin">
                        <Storyboard Timeline.DesiredFrameRate="30">
                            <DoubleAnimation Storyboard.TargetName="C1" Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.0" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <CircleEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetName="C2" Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.1" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <CircleEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetName="C3" Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.2" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <CircleEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetName="C4" Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.3" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <CircleEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetName="C5" Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:2" BeginTime="0:0:0.4" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <CircleEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>

                <DataTrigger.ExitActions>
                    <PauseStoryboard BeginStoryboardName="SpinBegin"/>
                </DataTrigger.ExitActions>
            </DataTrigger>

        </ControlTemplate.Triggers>

    </ControlTemplate>

</ResourceDictionary>