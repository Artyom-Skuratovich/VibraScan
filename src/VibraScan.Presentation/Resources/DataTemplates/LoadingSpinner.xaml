<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VibraScan.Presentation.ViewModels.Models">

    <Style x:Key="SpinnerCircleStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="#2563EB" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="RenderOptions.EdgeMode" Value="Unspecified" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <Style
        x:Key="SpinnerElement"
        x:Shared="False"
        TargetType="FrameworkElement">
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="100" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type local:LoadingSpinner}">
        <Grid x:Name="LayoutRoot" Visibility="Visible">
            <Viewbox Width="100" Height="100">
                <Canvas
                    Width="100"
                    Height="100"
                    CacheMode="BitmapCache">
                    <Grid x:Name="C1" Style="{StaticResource SpinnerElement}">
                        <Ellipse Style="{StaticResource SpinnerCircleStyle}" />
                    </Grid>
                    <Grid x:Name="C2" Style="{StaticResource SpinnerElement}">
                        <Ellipse Style="{StaticResource SpinnerCircleStyle}" />
                    </Grid>
                    <Grid x:Name="C3" Style="{StaticResource SpinnerElement}">
                        <Ellipse Style="{StaticResource SpinnerCircleStyle}" />
                    </Grid>
                    <Grid x:Name="C4" Style="{StaticResource SpinnerElement}">
                        <Ellipse Style="{StaticResource SpinnerCircleStyle}" />
                    </Grid>
                    <Grid x:Name="C5" Style="{StaticResource SpinnerElement}">
                        <Ellipse Style="{StaticResource SpinnerCircleStyle}" />
                    </Grid>
                </Canvas>
            </Viewbox>
        </Grid>

        <DataTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard x:Name="SpinBegin">
                    <Storyboard Timeline.DesiredFrameRate="30">
                        <DoubleAnimation
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="C1"
                            Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                            From="0"
                            To="360"
                            Duration="0:0:2">
                            <DoubleAnimation.EasingFunction>
                                <CircleEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <DoubleAnimation
                            BeginTime="0:0:0.1"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="C2"
                            Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                            From="0"
                            To="360"
                            Duration="0:0:2">
                            <DoubleAnimation.EasingFunction>
                                <CircleEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <DoubleAnimation
                            BeginTime="0:0:0.2"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="C3"
                            Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                            From="0"
                            To="360"
                            Duration="0:0:2">
                            <DoubleAnimation.EasingFunction>
                                <CircleEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <DoubleAnimation
                            BeginTime="0:0:0.3"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="C4"
                            Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                            From="0"
                            To="360"
                            Duration="0:0:2">
                            <DoubleAnimation.EasingFunction>
                                <CircleEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <DoubleAnimation
                            BeginTime="0:0:0.4"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="C5"
                            Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                            From="0"
                            To="360"
                            Duration="0:0:2">
                            <DoubleAnimation.EasingFunction>
                                <CircleEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>

            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                <DataTrigger.EnterActions>
                    <PauseStoryboard BeginStoryboardName="SpinBegin" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <ResumeStoryboard BeginStoryboardName="SpinBegin" />
                </DataTrigger.ExitActions>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter TargetName="LayoutRoot" Property="Visibility" Value="Collapsed" />
            </DataTrigger>

            <EventTrigger RoutedEvent="Unloaded">
                <RemoveStoryboard BeginStoryboardName="SpinBegin" />
            </EventTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>