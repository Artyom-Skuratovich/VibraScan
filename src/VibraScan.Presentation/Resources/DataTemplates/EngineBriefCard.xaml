<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="clr-namespace:VibraScan.Domain.ValueObjects;assembly=VibraScan.Domain"
    xmlns:vm="clr-namespace:VibraScan.Presentation.ViewModels">

    <DataTemplate DataType="{x:Type vm:EngineBriefViewModel}">
        <Grid
            x:Name="Root"
            Width="150"
            MinHeight="90"
            ToolTip="{Binding Engine.Name}"
            ToolTipService.BetweenShowDelay="0">

            <Border
                x:Name="BackgroundLayer"
                Background="#DBEAFE"
                BorderBrush="#60A5FA"
                BorderThickness="1"
                CornerRadius="2"
                SnapsToDevicePixels="True" />

            <Border
                x:Name="HoverOverlay"
                Background="Black"
                CornerRadius="{Binding CornerRadius, ElementName=BackgroundLayer}"
                IsHitTestVisible="False"
                Opacity="0" />

            <Grid Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Command="{Binding SelectCommand}" MouseAction="LeftClick" />
                    <!--  TODO: Добавить обработку двойного клика для открытия окна с деталями.  -->
                </Grid.InputBindings>

                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                    <TextBlock
                        MaxWidth="130"
                        MaxHeight="40"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="#1E293B"
                        Text="{Binding Engine.Name}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <Grid Margin="0,10,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="10"
                            FontWeight="Medium"
                            Foreground="#64748B"
                            Text="Пров.: " />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="10"
                            Foreground="#334155"
                            Text="{Binding Engine.LastInspectionDate, StringFormat={}{0:dd.MM.yyyy}, TargetNullValue=--.--.----}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            FontSize="10"
                            FontWeight="Medium"
                            Foreground="#64748B"
                            Text="След.: " />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="10"
                            Foreground="#334155"
                            Text="{Binding Engine.NextInspectionDate, StringFormat={}{0:dd.MM.yyyy}, TargetNullValue=--.--.----}" />
                    </Grid>
                </StackPanel>

                <CheckBox
                    Margin="5,5,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsChecked="{Binding IsChecked}"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Grid Width="18" Height="18">
                                            <Border
                                                BorderBrush="#2563EB"
                                                BorderThickness="1"
                                                CornerRadius="50"
                                                SnapsToDevicePixels="True">
                                                <Ellipse
                                                    x:Name="FlagBg"
                                                    Fill="#2563EB"
                                                    Stroke="White"
                                                    StrokeThickness="1.5" />
                                            </Border>

                                            <TextBlock
                                                x:Name="Flag"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="9"
                                                Foreground="White"
                                                Text="&#xE73E;" />
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                                <Setter TargetName="Flag" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="FlagBg" Property="Fill" Value="White" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </Grid>
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Engine.Condition}" Value="{x:Static d:Condition.Excellent}">
                <Setter TargetName="BackgroundLayer" Property="Background" Value="#F1F8F1" />
                <Setter TargetName="BackgroundLayer" Property="BorderBrush" Value="#A3D9A5" />
            </DataTrigger>

            <DataTrigger Binding="{Binding Engine.Condition}" Value="{x:Static d:Condition.Satisfactory}">
                <Setter TargetName="BackgroundLayer" Property="Background" Value="#FFFBF0" />
                <Setter TargetName="BackgroundLayer" Property="BorderBrush" Value="#E9D5A1" />
            </DataTrigger>

            <DataTrigger Binding="{Binding Engine.Condition}" Value="{x:Static d:Condition.Unsatisfactory}">
                <Setter TargetName="BackgroundLayer" Property="Background" Value="#FFF7F0" />
                <Setter TargetName="BackgroundLayer" Property="BorderBrush" Value="#F4C7A0" />
            </DataTrigger>

            <DataTrigger Binding="{Binding Engine.Condition}" Value="{x:Static d:Condition.Bad}">
                <Setter TargetName="BackgroundLayer" Property="Background" Value="#FFF1F1" />
                <Setter TargetName="BackgroundLayer" Property="BorderBrush" Value="#E9A1A1" />
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, ElementName=Root}" Value="True" />
                    <Condition Binding="{Binding CanCheck}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.05" />
                <Setter TargetName="Root" Property="Cursor" Value="Hand" />
                <Setter TargetName="BackgroundLayer" Property="BorderBrush" Value="#2563EB" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>