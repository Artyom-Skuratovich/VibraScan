<Application
    x:Class="VibraScan.Presentation.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:VibraScan.Presentation.Common.Converters"
    xmlns:local="clr-namespace:VibraScan.Presentation"
    ShutdownMode="OnExplicitShutdown">
    
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Converters.xaml" />
                
                <ResourceDictionary Source="/Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Inputs.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Navigation.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Progress.xaml" />
                
                <ResourceDictionary Source="/Resources/DataTemplates/EngineBriefCard.xaml" />
                <ResourceDictionary Source="/Resources/DataTemplates/ChartCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>
    
</Application>