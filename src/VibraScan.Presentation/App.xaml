<Application
    x:Class="VibraScan.Presentation.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:VibraScan.Presentation.Common.Converters"
    xmlns:local="clr-namespace:VibraScan.Presentation"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:EnumToBooleanConverter x:Key="EnumToBool" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Inputs.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Navigation.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>
</Application>